<Window x:Class="AttendanceManager.AdminApp.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AttendanceManager - Login" Height="500" Width="420"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Border Style="{StaticResource CardBorder}" VerticalAlignment="Center" HorizontalAlignment="Center"
                Width="340" Margin="0">
            <StackPanel>
                <!-- Logo / Title -->
                <TextBlock Text="AttendanceManager" FontSize="24" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"
                           Margin="0,0,0,5" />
                <TextBlock Text="Workforce Management System" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                           Margin="0,0,0,30" />

                <!-- Server URL -->
                <TextBlock Text="Server URL" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,5" />
                <TextBox x:Name="TxtServerUrl" Style="{StaticResource ModernTextBox}"
                         Text="https://localhost:5001" Margin="0,0,0,15" />

                <!-- Email -->
                <TextBlock Text="Email Address" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,5" />
                <TextBox x:Name="TxtEmail" Style="{StaticResource ModernTextBox}" Margin="0,0,0,15" />

                <!-- Password -->
                <TextBlock Text="Password" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,5" />
                <PasswordBox x:Name="TxtPassword" FontSize="14" Padding="12,8"
                             BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,20" />

                <!-- Error Message -->
                <TextBlock x:Name="TxtError" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,0,0,15" Visibility="Collapsed" />

                <!-- Login Button -->
                <Button x:Name="BtnLogin" Content="Sign In" Style="{StaticResource PrimaryButton}"
                        Click="BtnLogin_Click" Height="42" />

                <TextBlock Text="v1.0.0" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
