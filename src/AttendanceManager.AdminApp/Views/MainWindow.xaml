<Window x:Class="AttendanceManager.AdminApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AttendanceManager - Dashboard" Height="768" Width="1280"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1E293B">
            <DockPanel>
                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="20,20,20,30">
                    <TextBlock Text="AttendanceManager" FontSize="18" FontWeight="Bold"
                               Foreground="White" Margin="0,0,0,5" />
                    <TextBlock x:Name="TxtUserName" FontSize="12" Foreground="#94A3B8" />
                    <TextBlock x:Name="TxtUserRole" FontSize="11" Foreground="#64748B" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,0">
                    <Button x:Name="BtnDashboard" Content="Dashboard" Click="NavButton_Click" Tag="Dashboard"
                            Style="{StaticResource SidebarButton}" />
                    <Button x:Name="BtnAttendance" Content="Attendance" Click="NavButton_Click" Tag="Attendance"
                            Style="{StaticResource SidebarButton}" />
                    <Button x:Name="BtnEmployees" Content="Employees" Click="NavButton_Click" Tag="Employees"
                            Style="{StaticResource SidebarButton}" />
                    <Button x:Name="BtnLeaves" Content="Leave Management" Click="NavButton_Click" Tag="Leaves"
                            Style="{StaticResource SidebarButton}" />
                    <Button x:Name="BtnReports" Content="Reports" Click="NavButton_Click" Tag="Reports"
                            Style="{StaticResource SidebarButton}" />
                    <Button x:Name="BtnHolidays" Content="Holidays" Click="NavButton_Click" Tag="Holidays"
                            Style="{StaticResource SidebarButton}" />
                    <Button x:Name="BtnNotifications" Content="Notifications" Click="NavButton_Click" Tag="Notifications"
                            Style="{StaticResource SidebarButton}" />
                    <Button x:Name="BtnApprovals" Content="Approvals" Click="NavButton_Click" Tag="Approvals"
                            Style="{StaticResource SidebarButton}" Visibility="Collapsed" />
                    <Button x:Name="BtnAuditLog" Content="Audit Log" Click="NavButton_Click" Tag="AuditLog"
                            Style="{StaticResource SidebarButton}" Visibility="Collapsed" />
                    <Button x:Name="BtnSettings" Content="Settings" Click="NavButton_Click" Tag="Settings"
                            Style="{StaticResource SidebarButton}" Visibility="Collapsed" />
                </StackPanel>

                <!-- Logout -->
                <Button DockPanel.Dock="Bottom" Content="Logout" Click="BtnLogout_Click"
                        Style="{StaticResource SidebarButton}" Margin="0,0,0,20"
                        VerticalAlignment="Bottom" Foreground="#EF4444" />
            </DockPanel>
        </Border>

        <!-- Content Area -->
        <Border Grid.Column="1" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ContentControl x:Name="ContentArea" Margin="30,20" />
            </ScrollViewer>
        </Border>
    </Grid>

    <Window.Resources>
        <Style x:Key="SidebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="25,12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" BorderThickness="3,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
</Window>
