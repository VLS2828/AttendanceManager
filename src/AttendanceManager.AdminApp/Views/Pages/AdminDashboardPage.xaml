<UserControl x:Class="AttendanceManager.AdminApp.Views.Pages.AdminDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Admin Dashboard" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" />

        <!-- Stats Cards -->
        <WrapPanel Margin="0,0,0,20">
            <Border Style="{StaticResource CardBorder}" Width="180" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="Total Employees" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtTotalEmployees" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Width="180" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="Online Now" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtOnline" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Width="180" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="Present Today" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtPresent" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Width="180" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="Absent Today" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtAbsent" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource DangerBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Width="180" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="On Leave" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtOnLeave" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Width="180" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="Late Arrivals" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtLateArrivals" Text="0" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Today's Attendance Table -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Today's Attendance" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15" />
                <DataGrid x:Name="DgAttendance" MaxHeight="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="180" />
                        <DataGridTextColumn Header="Login Time" Binding="{Binding LoginTime}" Width="100" />
                        <DataGridTextColumn Header="Logout Time" Binding="{Binding LogoutTime}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Total Hours" Binding="{Binding TotalHours, StringFormat=F2}" Width="100" />
                        <DataGridTextColumn Header="Idle (min)" Binding="{Binding IdleTimeMinutes, StringFormat=F0}" Width="90" />
                        <DataGridTextColumn Header="Effective Hours" Binding="{Binding EffectiveHours, StringFormat=F2}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
