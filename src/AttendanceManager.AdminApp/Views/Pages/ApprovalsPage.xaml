<UserControl x:Class="AttendanceManager.AdminApp.Views.Pages.ApprovalsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,20">
            <TextBlock Text="Approvals" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" />
            <Button Content="Refresh" Style="{StaticResource PrimaryButton}"
                    DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="15,8"
                    Click="BtnRefresh_Click" />
        </DockPanel>

        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="TxtCount" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,0,12" />
                <DataGrid x:Name="DgApprovals" MaxHeight="500"
                          SelectionChanged="DgApprovals_SelectionChanged"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type"       Binding="{Binding Type}"         Width="90" />
                        <DataGridTextColumn Header="Employee"   Binding="{Binding EmployeeName}"  Width="140" />
                        <DataGridTextColumn Header="Summary"    Binding="{Binding Summary}"       Width="*" />
                        <DataGridTextColumn Header="Requested"  Binding="{Binding RequestedAt}"   Width="150" />
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel x:Name="PnlActions" Orientation="Horizontal" Margin="0,12,0,0"
                            Visibility="Collapsed">
                    <Button Content="Approve" Style="{StaticResource PrimaryButton}" Padding="15,8"
                            Background="#16A34A" Click="BtnApprove_Click" Margin="0,0,10,0" />
                    <Button Content="Reject" Padding="15,8" Click="BtnReject_Click"
                            Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
