<UserControl x:Class="AttendanceManager.AdminApp.Views.Pages.AttendancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Attendance Management" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" />

        <!-- Filter Bar -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Date:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14" />
                <DatePicker x:Name="DpDate" SelectedDate="{x:Static sys:DateTime.Today}"
                            xmlns:sys="clr-namespace:System;assembly=mscorlib"
                            Width="150" Margin="0,0,20,0" />
                <Button Content="Load" Style="{StaticResource PrimaryButton}"
                        Click="BtnLoad_Click" Padding="15,8" />
                <Button x:Name="BtnManualEntry" Content="Manual Entry" Margin="15,0,0,0"
                        Style="{StaticResource PrimaryButton}" Padding="15,8"
                        Click="BtnManualEntry_Click" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Attendance Grid -->
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <DataGrid x:Name="DgAttendance" MaxHeight="500"
                          SelectionChanged="DgAttendance_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="180" />
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="110" />
                        <DataGridTextColumn Header="Login" Binding="{Binding LoginTime}" Width="100" />
                        <DataGridTextColumn Header="Logout" Binding="{Binding LogoutTime}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Total Hrs" Binding="{Binding TotalHours, StringFormat=F2}" Width="90" />
                        <DataGridTextColumn Header="Idle (min)" Binding="{Binding IdleTimeMinutes, StringFormat=F0}" Width="90" />
                        <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveHours, StringFormat=F2}" Width="100" />
                        <DataGridTextColumn Header="Computer" Binding="{Binding ComputerName}" Width="120" />
                        <DataGridTextColumn Header="Manual" Binding="{Binding IsManualEntry}" Width="70" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Admin Actions -->
                <StackPanel x:Name="PnlActions" Orientation="Horizontal" Margin="0,15,0,0" Visibility="Collapsed">
                    <Button Content="Edit Status" Style="{StaticResource PrimaryButton}" Padding="12,6"
                            Click="BtnEditStatus_Click" Margin="0,0,10,0" />
                    <Button Content="Edit Login Time" Style="{StaticResource PrimaryButton}" Padding="12,6"
                            Click="BtnEditLoginTime_Click" Margin="0,0,10,0" />
                    <Button Content="Edit Logout Time" Style="{StaticResource PrimaryButton}" Padding="12,6"
                            Click="BtnEditLogoutTime_Click" Margin="0,0,10,0" />
                    <Button Content="Delete" Padding="12,6" Margin="0,0,10,0"
                            Click="BtnDelete_Click" Background="#DC2626" Foreground="White"
                            BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
