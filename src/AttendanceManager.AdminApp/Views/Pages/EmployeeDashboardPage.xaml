<UserControl x:Class="AttendanceManager.AdminApp.Views.Pages.EmployeeDashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="My Dashboard" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" />

        <!-- Today's Summary -->
        <WrapPanel Margin="0,0,0,20">
            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="Login Time" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtLoginTime" Text="--:--" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="Logout Time" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtLogoutTime" Text="--:--" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="Total Hours" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtTotalHours" Text="0.00" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="Idle Time" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtIdleTime" Text="0 min" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorder}" Width="200" Margin="0,0,15,15">
                <StackPanel>
                    <TextBlock Text="Effective Hours" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock x:Name="TxtEffectiveHours" Text="0.00" FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource InfoBrush}" Margin="0,5,0,0" />
                </StackPanel>
            </Border>
        </WrapPanel>

        <!-- Leave Balance -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Leave Balance" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15" />
                <DataGrid x:Name="DgLeaveBalance" MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Leave Type" Binding="{Binding LeaveTypeName}" Width="200" />
                        <DataGridTextColumn Header="Total Days" Binding="{Binding TotalDays}" Width="120" />
                        <DataGridTextColumn Header="Used Days" Binding="{Binding UsedDays}" Width="120" />
                        <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingDays}" Width="120" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>

        <!-- Monthly Summary -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Monthly Summary" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15" />
                <WrapPanel>
                    <StackPanel Margin="0,0,40,10">
                        <TextBlock Text="Present" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtPresentDays" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,40,10">
                        <TextBlock Text="Absent" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtAbsentDays" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,40,10">
                        <TextBlock Text="Leave" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtLeaveDays" Text="0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,40,10">
                        <TextBlock Text="Avg Hours/Day" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock x:Name="TxtAvgHours" Text="0.0" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InfoBrush}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Monthly Attendance Table -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="Attendance Calendar" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15" />
                <DataGrid x:Name="DgMonthlyAttendance" MaxHeight="300">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120" />
                        <DataGridTextColumn Header="Login" Binding="{Binding LoginTime}" Width="100" />
                        <DataGridTextColumn Header="Logout" Binding="{Binding LogoutTime}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalHours, StringFormat=F2}" Width="80" />
                        <DataGridTextColumn Header="Idle" Binding="{Binding IdleTimeMinutes, StringFormat=F0}" Width="80" />
                        <DataGridTextColumn Header="Effective" Binding="{Binding EffectiveHours, StringFormat=F2}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
