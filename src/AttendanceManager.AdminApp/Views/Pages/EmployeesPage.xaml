<UserControl x:Class="AttendanceManager.AdminApp.Views.Pages.EmployeesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,20">
            <TextBlock Text="Employee Management" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" />
            <Button x:Name="BtnAdd" Content="Add Employee" Style="{StaticResource PrimaryButton}"
                    DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="15,8"
                    Click="BtnAdd_Click" Visibility="Collapsed" />
        </DockPanel>

        <Border Style="{StaticResource CardBorder}">
            <DataGrid x:Name="DgEmployees" MaxHeight="600">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Code" Binding="{Binding EmployeeCode}" Width="80" />
                    <DataGridTextColumn Header="Name" Binding="{Binding FullName}" Width="180" />
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="200" />
                    <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="120" />
                    <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="130" />
                    <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="80" />
                    <DataGridTextColumn Header="Joining Date" Binding="{Binding JoiningDate}" Width="110" />
                    <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
