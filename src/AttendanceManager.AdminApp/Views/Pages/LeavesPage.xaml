<UserControl x:Class="AttendanceManager.AdminApp.Views.Pages.LeavesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,20">
            <TextBlock Text="Leave Management" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" />
            <Button Content="Apply for Leave" Style="{StaticResource PrimaryButton}"
                    DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="15,8"
                    Click="BtnApply_Click" />
        </DockPanel>

        <!-- Pending Requests (Admin) -->
        <Border x:Name="PnlPending" Style="{StaticResource CardBorder}" Margin="0,0,0,15" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Pending Leave Requests" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15" />
                <DataGrid x:Name="DgPending" MaxHeight="300" SelectionChanged="DgPending_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="150" />
                        <DataGridTextColumn Header="Type" Binding="{Binding LeaveTypeName}" Width="120" />
                        <DataGridTextColumn Header="From" Binding="{Binding StartDate}" Width="110" />
                        <DataGridTextColumn Header="To" Binding="{Binding EndDate}" Width="110" />
                        <DataGridTextColumn Header="Days" Binding="{Binding TotalDays}" Width="60" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="200" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="PnlPendingActions" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                    <Button Content="Approve" Style="{StaticResource PrimaryButton}" Padding="12,6"
                            Click="BtnApprove_Click" Margin="0,0,10,0" Background="#16A34A" />
                    <Button Content="Reject" Padding="12,6" Click="BtnReject_Click" Margin="0,0,10,0"
                            Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Cancel" Padding="12,6" Click="BtnCancel_Click"
                            Background="#F59E0B" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- My Leave Requests -->
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="TxtLeaveTitle" Text="My Leave Requests" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15" />
                <DataGrid x:Name="DgMyLeaves" MaxHeight="400">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Employee" Binding="{Binding EmployeeName}" Width="150" />
                        <DataGridTextColumn Header="Type" Binding="{Binding LeaveTypeName}" Width="120" />
                        <DataGridTextColumn Header="From" Binding="{Binding StartDate}" Width="110" />
                        <DataGridTextColumn Header="To" Binding="{Binding EndDate}" Width="110" />
                        <DataGridTextColumn Header="Days" Binding="{Binding TotalDays}" Width="60" />
                        <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="180" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                        <DataGridTextColumn Header="Remarks" Binding="{Binding AdminRemarks}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
