<UserControl x:Class="AttendanceManager.AdminApp.Views.Pages.NotificationsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <DockPanel Margin="0,0,0,20">
            <TextBlock Text="Notifications" FontSize="24" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}" DockPanel.Dock="Left" />
            <Button Content="Mark All Read" Style="{StaticResource PrimaryButton}"
                    DockPanel.Dock="Right" HorizontalAlignment="Right" Padding="15,8"
                    Click="BtnMarkAllRead_Click" />
        </DockPanel>

        <Border Style="{StaticResource CardBorder}">
            <DataGrid x:Name="DgNotifications" MaxHeight="600">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200" />
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" />
                    <DataGridTextColumn Header="Read" Binding="{Binding IsRead}" Width="60" />
                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt}" Width="150" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </StackPanel>
</UserControl>
