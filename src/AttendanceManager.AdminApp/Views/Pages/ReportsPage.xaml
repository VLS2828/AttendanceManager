<UserControl x:Class="AttendanceManager.AdminApp.Views.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Reports" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" />

        <!-- Report Selection -->
        <Border Style="{StaticResource CardBorder}" Margin="0,0,0,15">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,20,10">
                        <TextBlock Text="Report Type:" FontSize="12" Margin="0,0,0,5" />
                        <ComboBox x:Name="CmbReport" Width="200" SelectedIndex="0">
                            <ComboBoxItem Content="Daily Attendance" Tag="daily" />
                            <ComboBoxItem Content="Late Arrivals" Tag="late-arrivals" />
                            <ComboBoxItem Content="Overtime" Tag="overtime" />
                            <ComboBoxItem Content="Idle Time" Tag="idle-time" />
                            <ComboBoxItem Content="Leave Summary" Tag="leave-summary" />
                            <ComboBoxItem Content="Holidays" Tag="holidays" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,20,10">
                        <TextBlock Text="Start Date:" FontSize="12" Margin="0,0,0,5" />
                        <DatePicker x:Name="DpStart" SelectedDate="{x:Static sys:DateTime.Today}"
                                    xmlns:sys="clr-namespace:System;assembly=mscorlib" Width="140" />
                    </StackPanel>
                    <StackPanel Margin="0,0,20,10">
                        <TextBlock Text="End Date:" FontSize="12" Margin="0,0,0,5" />
                        <DatePicker x:Name="DpEnd" SelectedDate="{x:Static sys:DateTime.Today}"
                                    xmlns:sys="clr-namespace:System;assembly=mscorlib" Width="140" />
                    </StackPanel>
                    <Button Content="Generate" Style="{StaticResource PrimaryButton}" Padding="15,8"
                            Click="BtnGenerate_Click" VerticalAlignment="Bottom" Margin="0,0,10,10" />
                    <Button Content="Export Excel" Padding="15,8" Click="BtnExportExcel_Click"
                            VerticalAlignment="Bottom" Margin="0,0,10,10"
                            Background="#16A34A" Foreground="White" BorderThickness="0" Cursor="Hand" />
                    <Button Content="Download CSV" Padding="15,8" Click="BtnDownloadCsv_Click"
                            VerticalAlignment="Bottom" Margin="0,0,10,10"
                            Background="#0369A1" Foreground="White" BorderThickness="0" Cursor="Hand" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Report Data -->
        <Border Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock x:Name="TxtReportTitle" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,15" />
                <DataGrid x:Name="DgReport" MaxHeight="500" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
