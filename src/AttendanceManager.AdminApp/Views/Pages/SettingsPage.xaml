<UserControl x:Class="AttendanceManager.AdminApp.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Application Settings" FontSize="24" FontWeight="Bold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,20" />

        <Border Style="{StaticResource CardBorder}">
            <DataGrid x:Name="DgSettings" MaxHeight="400" AutoGenerateColumns="True" />
        </Border>
    </StackPanel>
</UserControl>
